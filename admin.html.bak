<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Panel | ÉLÉGANCE</title><link rel="stylesheet" href="admin.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body>
<section id="adminLogin" class="admin-login"><div class="login-card"><div class="login-brand">ÉLÉGANCE</div><p>Store Administration</p><form id="loginForm"><label>Username<input id="loginUser" autocomplete="username" required></label><label>Password<input id="loginPass" type="password" autocomplete="current-password" required></label><button class="login-btn">Sign In</button><div id="loginError" class="error"></div></form><p class="login-hint">Demo login: admin / admin123</p></div></section>
<section id="adminApp" class="admin-shell" hidden><aside class="sidebar"><div class="side-brand">ÉLÉGANCE</div><div class="side-sub">STORE ADMIN</div><nav class="admin-nav"><button data-view="dashboard" class="active"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></button><button data-view="products"><i class="fa-solid fa-box"></i><span>Products</span></button><button data-view="orders"><i class="fa-solid fa-receipt"></i><span>Orders</span></button><button data-view="customers"><i class="fa-solid fa-users"></i><span>Customers</span></button><button data-view="settings"><i class="fa-solid fa-gear"></i><span>Settings</span></button></nav><button id="logoutBtn" class="logout"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></button></aside>
<main class="main"><div class="topbar"><div><h1 id="pageTitle">Dashboard</h1><small>Manage your fragrance store</small></div></div>
<section id="viewDashboard"><div class="stats"><div class="stat"><div class="ico"><i class="fa-solid fa-box"></i></div><strong id="statProducts">0</strong><span>Total Products</span></div><div class="stat"><div class="ico"><i class="fa-solid fa-receipt"></i></div><strong id="statOrders">0</strong><span>Total Orders</span></div><div class="stat"><div class="ico"><i class="fa-solid fa-users"></i></div><strong id="statCustomers">0</strong><span>Customers</span></div><div class="stat"><div class="ico"><i class="fa-solid fa-dollar-sign"></i></div><strong id="statRevenue">$0</strong><span>Order Revenue</span></div></div><div class="panel"><div class="panel-head"><h2>Recent Orders</h2><button class="secondary-btn" onclick="document.querySelector('[data-view=orders]').click()">View All</button></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody id="recentOrders"></tbody></table></div></div></section>
<section id="viewProducts" hidden><div class="panel"><div class="panel-head"><h2>Products <small id="productCount"></small></h2><button id="addProductBtn" class="primary-btn"><i class="fa-solid fa-plus"></i> Add Product</button></div><div class="tool-row"><button id="exportProducts" class="secondary-btn">Export Products</button><label class="secondary-btn">Import Products <input id="importProducts" type="file" accept="application/json" hidden></label></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Featured</th><th>Actions</th></tr></thead><tbody id="productsTable"></tbody></table></div></div></section>
<section id="viewOrders" hidden><div class="panel"><div class="panel-head"><h2>Orders <small id="orderCount"></small></h2><button id="exportOrders" class="secondary-btn">Export Orders</button></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead><tbody id="ordersTable"></tbody></table></div></div></section>
<section id="viewCustomers" hidden><div class="panel"><div class="panel-head"><h2>Customers <small id="customerCount"></small></h2></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Orders</th><th>Spent</th></tr></thead><tbody id="customersTable"></tbody></table></div></div></section>
<section id="viewSettings" hidden><div class="panel"><div class="panel-head"><h2>Store Settings</h2></div><form id="settingsForm" class="settings-form"><label>Store Name<input id="sStore"></label><label>Currency<select id="sCurrency"><option>USD</option><option>PKR</option><option>EUR</option><option>GBP</option></select></label><label>Admin Email<input id="sEmail" type="email"></label><button class="primary-btn">Save Settings</button></form></div><div class="panel"><h2>Admin Access</h2><p style="color:#827474;font-size:13px">This starter admin uses browser storage. For a live multi-user store, connect the panel to a secure backend/database before deployment.</p></div></section>
</main></section>
<div id="productModal" class="modal" hidden><div class="modal-card"><div class="modal-head"><h2>Product</h2><button id="closeProduct" class="close">&times;</button></div><form id="productForm" class="admin-form"><input id="productIndex" type="hidden"><label>Product ID<input id="pId"></label><label>Name<input id="pName" required></label><label>Price (USD)<input id="pPrice" inputmode="decimal" required></label><label>Sale Price<input id="pSale" inputmode="decimal"></label><label>Category<select id="pCategory"><option value="women">Women</option><option value="men">Men</option><option value="unisex">Unisex</option><option value="oud">Oud & Attar</option><option value="gift">Gift Sets</option></select></label><label>Collections<input id="pCollections" placeholder="women, new-arrivals"></label><label class="full">Image URL<input id="pImage"></label><label class="full">Fragrance Notes<textarea id="pNotes"></textarea></label><label class="check full"><input id="pFeatured" type="checkbox"> Featured product</label><div class="modal-actions full"><button type="button" id="cancelProduct" class="secondary-btn">Cancel</button><button class="primary-btn">Save Product</button></div></form></div></div>
<div id="orderDetails" class="modal" hidden><div class="modal-card"><div class="modal-head"><h2>Order Details</h2><button id="closeOrder" class="close">&times;</button></div><div id="orderDetailsBody"></div></div></div><div id="adminToast" class="admin-toast"></div><script src="products-data.js"></script><script src="admin.js"></script></body></html>
